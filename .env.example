# Pristaine — Environment Variables
#
# This file contains VARIABLE NAMES ONLY, never values.
# Do not put secrets, keys, or environment-specific values in this file.

# --- Public frontend configuration (safe for browser) ---
# Supabase project URL used by the frontend to invoke approved Edge Functions
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key for invoking approved functions; private tables remain protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site configuration (frontend) ---
# Canonical site URL for sitemap, structured data and canonical tags
SITE_URL=
# Calendly event URL for the booking page
CALENDLY_EVENT_URL=
# Kill switch for the AI assistant: when false, the chat shows the unavailable message
ASSISTANT_ENABLED=
# OpenAI model name (used by chat-assistant Edge Function, not the browser)
OPENAI_MODEL=
# Days before anonymous chats are deleted (90 by default)
CHAT_RETENTION_DAYS=

# --- Supabase Edge Function configuration (server-side only, configured in Supabase) ---
# These are automatically available to deployed Edge Functions. Never put them
# in NEXT_PUBLIC_* variables or commit their values.
# SUPABASE_URL — platform-provided in the Edge Function runtime
# SUPABASE_ANON_KEY — platform-provided in the Edge Function runtime
# SUPABASE_SERVICE_ROLE_KEY — platform-managed server-side key; never expose to browser

# --- Provider secrets (server-side only, configured as Supabase Edge Function secrets) ---
# OPENAI_API_KEY — AI model access
# HUBSPOT_ACCESS_TOKEN — CRM sync
# CALENDLY_WEBHOOK_SIGNING_KEY — Confirms booking messages come from Calendly
# EMAIL_PROVIDER_API_KEY — Email service access (optional, form works without it)

# --- Optional email configuration (server-side) ---
# CONTACT_TO_ADDRESS — Where form messages are delivered
# EMAIL_FROM_ADDRESS — Sender of form messages

# --- Analytics (only after owner approval) ---
# ANALYTICS_ID — Set only when a tool is chosen
